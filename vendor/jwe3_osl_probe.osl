// Minimal OptiX/OSL backend probe. This deliberately contains no texture or layer logic.
// If this constant colour cannot render, the backend/driver is the blocker rather than JWE3 math.
shader JWE3_OSL_Probe(
    output color Color = color(0.85, 0.12, 0.65)
)
{
    Color = color(0.85, 0.12, 0.65);
}
