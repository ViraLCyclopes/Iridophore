// One-layer JWE3 triplanar projection probe for Cycles OptiX OSL.
// The texture path is deliberately a constant: OptiX OSL requires a resolvable constant path
// for every texture() invocation. This is a diagnostic before the VariantEditor generates one
// complete shader containing all of a species' constant swatch paths.

void layer_uv(
    float raw_u, float raw_v,
    float offset_u, float offset_v,
    float tile_u, float tile_v,
    float pivot_u, float pivot_v,
    float angle,
    output float u, output float v)
{
    float px = pivot_u;
    float py = pivot_v - 1.0;
    float a = (raw_u - offset_u) * tile_u - px;
    float b = (raw_v - offset_v) * tile_v - py;
    float c = cos(angle);
    float s = sin(angle);
    u = a * c - b * s + px;
    v = a * s + b * c + py;
}

shader JWE3_OSL_Triplanar_Probe(
    string Texture = "D:/JWE2 Stuff/Personal Mods/JWE3/Images and Models/Dinosaurs/SwatchLibrary/swatch_anky_ankylo_backplates.pdiffusetexture_[27].png"
        [[ string widget = "filename" ]],
    point ModelCenter = point(-0.0002439022, 1.7392598391, 0.6403816305),
    float PositionScale = 0.1956249829,
    float OffsetU = 0.5,
    float OffsetV = 0.5,
    float TileU = 9.4200000763,
    float TileV = 4.5300002098,
    float PivotU = 0.0,
    float PivotV = 0.0,
    float Angle = 0.0,
    output color Color = color(0.5)
)
{
    point object_p = transform("common", "object", P);
    vector blender_q = vector(object_p) - vector(ModelCenter);
    normal blender_n = normalize(transform("common", "object", N));

    // Cobra imports Game -> Blender as B(X,Y,Z) = G(-X,-Z,Y).
    // Undo that conversion before applying the game shader's axis pairs:
    // G(X,Y,Z) = B(-X,Z,-Y).
    vector q = vector(-blender_q[0], blender_q[2], -blender_q[1])
             * PositionScale;
    normal object_n = normalize(normal(-blender_n[0], blender_n[2],
                                       -blender_n[1]));

    vector raw_w = vector(
        clamp((abs(object_n[0]) - 0.5735764503) * 4.0720658302, 0.0, 1.0),
        clamp((abs(object_n[1]) - 0.5735764503) * 4.0720658302, 0.0, 1.0),
        clamp((abs(object_n[2]) - 0.5735764503) * 4.0720658302, 0.0, 1.0));
    vector w = raw_w / max(raw_w[0] + raw_w[1] + raw_w[2], 1.0e-8);

    float uy, vy, ux, vx, uz, vz;
    // Shader 0300 order: (-X,-Z)*|Ny|, (-Z,-Y)*|Nx|, (-X,-Y)*|Nz|.
    layer_uv(-q[0], -q[2], OffsetU, OffsetV, TileU, TileV,
             PivotU, PivotV, Angle, uy, vy);
    layer_uv(-q[2], -q[1], OffsetU, OffsetV, TileU, TileV,
             PivotU, PivotV, Angle, ux, vx);
    layer_uv(-q[0], -q[1], OffsetU, OffsetV, TileU, TileV,
             PivotU, PivotV, Angle, uz, vz);

    // Wrap explicitly: OptiX OSL did not reliably honor the texture() periodic
    // option during the live viewport probe.
    float sy = uy - floor(uy);
    float ty = vy - floor(vy);
    float sx = ux - floor(ux);
    float tx = vx - floor(vx);
    float sz = uz - floor(uz);
    float tz = vz - floor(vz);

    color missing = color(1.0, 0.0, 1.0);
    color plane_y = texture(Texture, sy, ty, "missingcolor", missing);
    color plane_x = texture(Texture, sx, tx, "missingcolor", missing);
    color plane_z = texture(Texture, sz, tz, "missingcolor", missing);

    // X-facing surfaces use the YZ plane, Y-facing surfaces use XZ, and
    // Z-facing surfaces use XY.
    Color = plane_y * w[1] + plane_x * w[0] + plane_z * w[2];
}
